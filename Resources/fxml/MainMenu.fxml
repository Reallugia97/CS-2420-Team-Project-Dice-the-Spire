<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="720.0" prefWidth="1280.0" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.MainMenu">
   <center>
      <VBox alignment="CENTER" spacing="15.0" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="241.0" prefWidth="983.0" text="Dice the Spire" textAlignment="CENTER">
               <font>
                  <Font size="150.0" />
               </font>
               <VBox.margin>
                  <Insets top="-100.0" />
               </VBox.margin>
            </Label>
            <Button mnemonicParsing="false" onAction="#openMap" prefHeight="94.0" prefWidth="852.0" scaleShape="false" text="Play">
               <font>
                  <Font size="65.0" />
               </font>
            </Button>
            <Button layoutX="204.0" layoutY="182.0" mnemonicParsing="false" onAction="#openSettings" prefHeight="92.0" prefWidth="850.0" scaleShape="false" text="Settings">
               <font>
                  <Font size="65.0" />
               </font>
            </Button>
            <Button layoutX="204.0" layoutY="258.0" mnemonicParsing="false" onAction="#quitGame" prefHeight="92.0" prefWidth="852.0" scaleShape="false" text="Exit">
               <font>
                  <Font size="65.0" />
               </font>
            </Button>
         </children>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </VBox>
   </center>
</BorderPane>
